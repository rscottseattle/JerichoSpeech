{
  "name": "jericho-speech",
  "version": "0.2.0",
  "description": "Live English-to-Spanish captions for church screens and ProPresenter.",
  "author": "Jesus Church",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop-dist --ignore-pattern release",
    "db:generate": "drizzle-kit generate",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:smoke": "npm run desktop:renderer && electron . --smoke-test",
    "desktop:import-key": "electron desktop/import-existing-key.cjs",
    "desktop:package": "npm run desktop:renderer && node desktop/package-mac.cjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "church.jesus.jerichospeech",
    "productName": "JerichoSpeech",
    "asar": true,
    "artifactName": "JerichoSpeech-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "afterPack": "desktop/after-pack.cjs",
    "files": [
      "desktop/main.cjs",
      "desktop/propresenter.cjs",
      "desktop-dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "signIgnore": "/Resources/.*\\.lproj/locale\\.pak$",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "JerichoSpeech uses a microphone or mixer feed to create live translated captions.",
        "NSLocalNetworkUsageDescription": "JerichoSpeech provides a local caption display for presentation software."
      }
    },
    "dmg": {
      "title": "JerichoSpeech ${version}",
      "backgroundColor": "#0a0b0c",
      "contents": [
        {
          "x": 145,
          "y": 180,
          "type": "file"
        },
        {
          "x": 425,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
